<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Knowledge Graph — Viewer</title>
<style>
  :root{--bg:#111417;--panel:#1a1e23;--panel2:#22272e;--ink:#e6e9ec;--dim:#9aa4ae;
        --accent:#e0a458;--line:#333a42}
  *{box-sizing:border-box}
  body{margin:0;font:14px/1.45 -apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink)}
  #app{display:flex;height:100vh}
  aside{width:264px;flex:0 0 264px;background:var(--panel);padding:12px;overflow-y:auto;border-right:1px solid var(--line)}
  aside.right{border-right:none;border-left:1px solid var(--line);width:320px;flex-basis:320px}
  h1{font-size:15px;margin:0 0 2px} h2{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--dim);margin:16px 0 6px}
  .sub{color:var(--dim);font-size:12px}
  input[type=text]{width:100%;padding:7px 9px;background:var(--panel2);border:1px solid var(--line);border-radius:6px;color:var(--ink)}
  #results div{padding:5px 8px;border-radius:5px;cursor:pointer;font-size:13px}
  #results div:hover{background:var(--panel2)}
  .typeRow{display:flex;align-items:center;gap:7px;padding:2.5px 0;font-size:13px;cursor:pointer}
  .dot{width:10px;height:10px;border-radius:50%;flex:0 0 10px}
  .typeRow .n{margin-left:auto;color:var(--dim);font-size:12px}
  .typeRow.off{opacity:.38}
  label.chk{display:flex;gap:7px;align-items:center;padding:3px 0;cursor:pointer;font-size:13px}
  button{background:var(--panel2);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:6px 10px;cursor:pointer;font-size:13px}
  a.btnlink{display:inline-block;background:var(--panel2);color:var(--accent);border:1px solid var(--line);border-radius:6px;padding:6px 10px;font-size:13px;text-decoration:none}
  a.btnlink:hover{border-color:var(--accent)}
  button:hover{border-color:var(--accent)}
  button.primary{background:var(--accent);color:#191204;border-color:var(--accent);font-weight:600}
  .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
  main{flex:1;position:relative;min-width:0}
  canvas{display:block;width:100%;height:100%;cursor:grab}
  #status{position:absolute;left:10px;bottom:8px;color:var(--dim);font-size:12px;background:rgba(17,20,23,.75);padding:3px 8px;border-radius:5px}
  #tip{position:absolute;pointer-events:none;background:#000c;color:#fff;padding:3px 8px;border-radius:5px;font-size:12px;display:none;max-width:300px}
  .kv{font-size:12.5px;margin:5px 0}.kv b{color:var(--dim);font-weight:600}
  .edgeRow{padding:4px 7px;border-radius:5px;cursor:pointer;font-size:12.5px}
  .edgeRow:hover{background:var(--panel2)}
  .pred{color:var(--accent)}
  #selTitle{font-size:15px;font-weight:650;margin:2px 0}
  .tagchip{font-family:ui-monospace,Menlo,monospace;font-size:12px;background:var(--panel2);padding:2px 6px;border-radius:4px}
  .empty{color:var(--dim);font-size:13px}
</style></head>
<body><div id="app">
<aside id="left">
  <h1>Knowledge graph</h1>
  <div class="sub" id="counts"></div>
  <div class="sub"><a href="https://larson-taguette.onrender.com/project/1" target="_blank" rel="noopener" style="color:#e0a458;text-decoration:none">Code in Taguette ↗</a></div>
  <h2>Find a node</h2>
  <input type="text" id="search" placeholder="label or id:slug…" autocomplete="off">
  <div id="results"></div>
  <h2>Layers</h2>
  <label class="chk"><input type="checkbox" id="showPrivate"> Show private (quarantined)</label>
  <label class="chk"><input type="checkbox" id="gapsOnly"> Gaps only (prompt nodes)</label>
  <h2>Types</h2>
  <div class="row" style="margin:0 0 4px"><button id="allTypes">All</button><button id="noTypes">None</button></div>
  <div id="types"></div>
  <h2>Graph file</h2>
  <div class="row"><button id="loadBtn">Load graph JSON…</button><button id="resetView">Reset view</button></div>
  <input type="file" id="file" accept=".json" style="display:none">
  <div class="sub" style="margin-top:8px">Or drop a graph JSON anywhere on this page. Embedded snapshot: <span id="snap"></span></div>
</aside>
<main id="main"><canvas id="cv"></canvas><div id="status"></div><div id="tip"></div></main>
<aside class="right" id="detail"><div class="empty">Select a node — its detail, connections, and the exact tags to use for it in Taguette appear here.</div></aside>
</div>
<script>
"use strict";
const GRAPH0 = {"meta": {"owner": "James Robert Larson", "generated": "2026-10-12", "node_count": 231, "edge_count": 503, "note": "Public layer only \u2014 exported and leak-checked by build_viewer.py --public-only."}, "schema": {"node_types": {"Person": "A human. self=true marks the graph owner. Others are collaborators, mentors, clients, citers.", "Organization": "Institution, employer, company, venue, or funder.", "Role": "A position held by a person at an organization over a time span.", "Era": "A named life period used to compute value persistence (e.g. Undergraduate, Research, Practice).", "Publication": "A peer-reviewed or published artifact.", "Artifact": "A non-publication output: toolkit, curriculum, product, program, deliverable.", "Skill": "A demonstrable competency, filtered by whether he is motivated to keep using it.", "Method": "A named, repeatable procedure for producing knowledge or output.", "Theory": "A named framework originated by someone else, which he applies or argues with. Never claimable as his.", "Contribution": "A named concept he originated, in a work that went to peer review. Claimable.", "Principle": "A general operating belief stated in his own unrefereed writing. Real, unvalidated.", "Value": "A durable commitment. Carries persistence and salience scores.", "Motivation": "What energizes the work. Distinct from Value: motivations pull, values constrain.", "Theme": "A recurring throughline detected across sources.", "Audience": "5P 'People' - who the work is for.", "Problem": "5P 'Problem' - what is being solved.", "Process": "5P 'Process' - the how the person prefers.", "Place": "5P 'Place' - environment and setting.", "Purpose": "5P 'Purpose' - the overarching why.", "Niche": "Intersection of what he can do, what he wants to do, and what is wanted.", "Evidence": "One concrete, citable proof-point. The atom of every generated document.", "Claim": "A positioning assertion the person is willing to make, supported by evidence.", "Source": "An ingested document. Every verified node traces to one."}, "edge_types": {"documented_in": "Node was extracted from this Source.", "authored": "Person -> Publication/Artifact.", "coauthored_with": "Person <-> Person on a shared output. Symmetric; stored once.", "held_role": "Person -> Role.", "role_at": "Role -> Organization.", "during_era": "Anything -> Era. Drives persistence scoring.", "produced": "Role/Project -> Publication/Artifact.", "part_of": "Project -> Project, or Artifact -> Artifact.", "demonstrates": "Evidence -> Skill/Method. The load-bearing edge for resumes.", "applies_method": "Publication/Project -> Method.", "grounded_in": "Publication/Artifact/Claim -> Theory/Contribution/Principle.", "expresses": "Evidence/Publication/Artifact -> Value. Increments value weight.", "motivated_by": "Anything -> Motivation.", "recurs_as": "Theme -> Value/Theory/Contribution/Principle. Cross-era pattern detection.", "translates_to": "Theory/Contribution/Principle -> another of the same. Same idea, different vocabulary or domain.", "transfers_to": "Skill/Method/Theory -> Audience/Problem. Adaptive-expertise transfer, made explicit.", "serves_audience": "Anything -> Audience.", "addresses_problem": "Anything -> Problem.", "uses_process": "Anything -> Process.", "sited_at": "Anything -> Place.", "serves_purpose": "Anything -> Purpose.", "composes_niche": "Skill/Motivation/Audience -> Niche.", "supports": "Evidence -> Claim. A claim with <2 supports is flagged weak.", "contradicts": "Anything <-> Anything. Kept deliberately: tensions are material.", "cites": "Publication -> Publication.", "extends": "Publication -> Publication/Theory/Contribution.", "shares_lineage_with": "Publication -> Publication. Same research program, no direct citation."}, "type_rules": {"Person": ["a specific named human"], "Organization": ["a named institution, employer, funder or venue", "persists independently of James"], "Role": ["a position held by a person at an organization", "has or could have a start date", "is NOT the work product of that position (that is Evidence or Artifact)"], "Era": ["a bounded life period used for persistence scoring", "has an order index"], "Source": ["is a document that exists as a file", "is cited by at least one other node as provenance"], "Publication": ["has an author list including James", "has a venue", "went to peer review or was submitted to it"], "Artifact": ["a made thing that is not a publication", "James contributed to making it", "outlived the occasion of its making"], "Skill": ["a capability James can exercise on demand", "evidenced by at least one Evidence node or an explicit credential"], "Method": ["a named, repeatable procedure for producing knowledge or output", "has a literature or a documented protocol", "is NOT a one-off activity (that is Evidence)"], "Theory": ["named conceptual framework", "originator is NOT James", "cited by name in at least one source"], "Contribution": ["named concept originated by James", "appears in a work he authored that went to peer review or submission", "generalises beyond a single episode"], "Principle": ["a general operating belief stated by James in his own words", "appears only in unrefereed writing", "generalises beyond a single episode"], "Value": ["a durable commitment inferable from repeated behaviour", "expressed by two or more independent nodes", "is NOT a statement of belief (that is Principle)"], "Motivation": ["what pulls James toward work", "distinct from Value: motivations attract, values constrain"], "Theme": ["a pattern detected ACROSS sources that no single source states", "must link three or more nodes"], "Audience": ["a group the work is for"], "Problem": ["a state of the world the work tries to change"], "Process": ["a preferred way of working, stated or repeatedly enacted"], "Place": ["a kind of setting, not a specific address"], "Purpose": ["an overarching why, at the level of a career rather than a project"], "Niche": ["an intersection of capability, motivation and demand", "must be marked proven, stated or latent"], "Evidence": ["one concrete, dated, citable thing that happened", "traceable to exactly one Source", "carries a Bandura efficacy source and a Kolb stage"], "Claim": ["an assertion James is willing to make about himself", "supported by two or more Evidence nodes"]}, "bandura_efficacy_sources": {"mastery": "Enactive attainment. I did this and it worked. Highest efficacy value.", "vicarious": "Modeling. I worked beside / learned from someone credible doing it.", "social_persuasion": "Others credibly told me, or told the world, that I can do this.", "physiological": "Somatic and affective state during the work. Energy, flow, dread."}, "bandura_agency_modes": {"personal": "I acted directly.", "proxy": "I acted through or with the help of others who had the leverage.", "collective": "A group acted; my contribution is real but not separable."}, "kolb_stages": {"CE": "Concrete Experience - the thing that happened.", "RO": "Reflective Observation - what I noticed about it.", "AC": "Abstract Conceptualization - the principle it demonstrates.", "AE": "Active Experimentation - what I now do differently / would do for you."}}, "nodes": [{"id": "src:asee2016", "type": "Source", "label": "ASEE 2016: Supporting K-12 Student Self-Direction with a Maker Family Ecosystem", "year": 2016, "venue": "ASEE Annual Conference & Exposition", "paper_id": "16215", "file": "asee_2016_supporting_k12_self_direction.pdf", "prov": "verified", "layer": "public"}, {"id": "src:asee2017", "type": "Source", "label": "ASEE 2017: Makers as Adaptive Experts-in-Training", "year": 2017, "venue": "ASEE Annual Conference & Exposition", "paper_id": "19916", "file": "ASEE_2017_Makers_as_AE.pdf", "prov": "verified", "layer": "public"}, {"id": "src:ieee_toe", "type": "Source", "label": "IEEE Transactions on Education 2020: Supporting Self-Directed Learning in a Project-Based Embedded Systems Design Course", "year": 2020, "venue": "IEEE Transactions on Education", "file": "IEEE Self-Directed Learning.pdf", "prov": "verified", "layer": "public", "citation": "J. Larson, S. S. Jordan, M. Lande, and S. Weiner, IEEE Trans. Educ., vol. 63, no. 2, pp. 88-97, May 2020, doi: 10.1109/TE.2020.2975358."}, {"id": "src:ieee_cogdev", "type": "Source", "label": "In publication, IEEE: Indicators of Developing Adaptive Design Expertise in a Project-Based, Embedded Systems Design Course", "year": 2026, "venue": "IEEE (in publication)", "file": "Cog Dev of Adaptive Expertise_v6c.docx", "prov": "verified", "layer": "public", "note": "Reworked by former colleagues from the 2018 draft. James retains first authorship."}, {"id": "src:laplace_hack", "type": "Source", "label": "La Place: Hackathons and Software Engineering Capstones Through Adaptive Expertise", "year": 2020, "venue": "Work In Progress", "file": "Cecilia Hackathon Adaptive Expertise Paper.pdf", "prov": "verified", "layer": "public", "authored_by_self": false}, {"id": "src:eagle_essay", "type": "Source", "label": "2018-01-30 Entrepreneurialism in my life (Eagle Scout narrative)", "year": 2018, "about_year": 2013, "file": "Autobio/20180130 Entrepreneurialism in my life.pdf", "prov": "verified", "layer": "public", "note": "Retrospective essay about the 2013 Eagle Scout project, structured on the hero's journey."}, {"id": "src:resume2018", "type": "Source", "label": "2018-03-14 Resume", "year": 2018, "file": "Autobio/20180314 Resume.pdf", "prov": "verified", "layer": "public"}, {"id": "src:more_statement", "type": "Source", "label": "2018-07-11 Personal Statement, MORE Research Grant", "year": 2018, "file": "Autobio/20180711 Personal Statement MORE Research Grant.docx", "prov": "verified", "layer": "public"}, {"id": "src:scoville", "type": "Source", "label": "2019-01-13 Scoville Peace Fellowship application essays", "year": 2019, "file": "Autobio/20190113 Scoville Scholarship Application Essay.docx", "prov": "verified", "layer": "public", "note": "The single most revealing document in the corpus. Two essays: a personal statement and a policy essay on U-238 reactors."}, {"id": "src:resume2024", "type": "Source", "label": "2024-01-15 Complete Resume", "year": 2024, "file": "Autobio/20240115 Complete Resume - James Larson.pdf", "prov": "verified", "layer": "public", "note": "The master record. Every role, dated, with hours per week. Everything else is a cut of this."}, {"id": "src:resume2025", "type": "Source", "label": "2025-11-11 Resume", "year": 2025, "file": "Autobio/20251111 Resume - James Larson.docx", "prov": "verified", "layer": "public"}, {"id": "src:resume2026", "type": "Source", "label": "2026-03-27 Resume", "year": 2026, "file": "Autobio/20260327 Resume - James Larson.docx", "prov": "verified", "layer": "public"}, {"id": "src:fie2020", "type": "Source", "label": "FIE 2020: Achieving Energy Justice Through Integration of Ethics and Emergent Technology in Energy Systems", "year": 2020, "venue": "Frontiers in Education", "file": "Additional Publications/20200218 FIE Technoethics article - U-238 interest.pdf", "prov": "verified", "layer": "public"}, {"id": "src:asee2021", "type": "Source", "label": "ASEE 2021: Student Recognition, Use, and Understanding of Engineering for One Planet Competencies and Outcomes in Project-Based Learning", "year": 2021, "venue": "ASEE Annual Conference", "paper_id": "33176", "file": "Additional Publications/20210602 EOP ASEE Final.pdf", "prov": "verified", "layer": "public"}, {"id": "src:eop_deck", "type": "Source", "label": "EOP Framework workshop deck", "year": 2021, "file": "EOP Framework.pptx", "prov": "verified", "layer": "public"}, {"id": "src:cw_plato", "type": "Source", "label": "2014-11-19 Plato & Boethius", "year": 2014, "file": "Classwork/20141119 Plato & Boethius Paper.docx", "prov": "verified", "layer": "public"}, {"id": "src:cw_marx", "type": "Source", "label": "2015-04-09 Marx and Nietzsche: The Reinvention of the Individual", "year": 2015, "file": "Classwork/20150409 Marx and Nietzsche.docx", "prov": "verified", "layer": "public"}, {"id": "src:cw_institutions", "type": "Source", "label": "2015-05-08 The Individual's Effect on the Practices and Institutions of their Time", "year": 2015, "file": "Classwork/20150508 Effecting Institutions.docx", "prov": "verified", "layer": "public"}, {"id": "src:cw_hst318", "type": "Source", "label": "2016-12-01 History of Engineering: Zeitgeist and Technological Landscape Through Mass Production", "year": 2016, "file": "Classwork/20161201 History of Engineering (HST 318) Final Paper.docx", "prov": "verified", "layer": "public", "note": "Footnotes Neeley's dissertation on adaptive design expertise. He was already reading it in a history seminar."}, {"id": "src:cw_meaning", "type": "Source", "label": "2017-04-05 Empowerment of the Individual in the Making of Meaning", "year": 2017, "file": "Classwork/20170405 The search for meaning.docx", "prov": "verified", "layer": "public"}, {"id": "src:cw_oppression", "type": "Source", "label": "2017-05-06 Escaping Oppression: Frameworks for Action with Radically Subjective Identities", "year": 2017, "file": "Classwork/20170506 Escaping Oppression.pdf", "prov": "verified", "layer": "public"}, {"id": "src:cw_federalism", "type": "Source", "label": "2018-11-06 Regulating Power Through the Framework of Federalism", "year": 2018, "file": "Classwork/20181106 Larson_discussion_paper.docx", "prov": "verified", "layer": "public"}, {"id": "src:cw_nuclear", "type": "Source", "label": "2018-12-03 EGR 598 Final Project: Nuclear Energy Ethics", "year": 2018, "file": "Classwork/20181203 Larson EGR 598 Final Project - Nuclear Energy Ethics.pdf", "prov": "verified", "layer": "public"}, {"id": "src:cw_transitions", "type": "Source", "label": "2019-03-20 Technological transitions as evolutionary reconfiguration processes", "year": 2019, "file": "Classwork/20190320 Technological transitions as evolutionary reconfiguration processes.pdf", "prov": "verified", "layer": "public"}, {"id": "src:cw_shuttle", "type": "Source", "label": "2019-04-11 Shuttle Electrification and Solar Utilization Report", "year": 2019, "file": "Classwork/20190411 Shuttle Electrification and Solar Utilization Report.pdf", "prov": "verified", "layer": "public"}, {"id": "era:pre_college", "type": "Era", "label": "Pre-College (Nevada)", "start": null, "end": 2014, "order": 0, "prov": "verified", "layer": "public", "note": "Now populated: Eagle Scout project (2013), We the People national competition, BRECE award."}, {"id": "era:undergrad", "type": "Era", "label": "ASU Undergraduate", "start": 2014, "end": 2018, "order": 1, "prov": "verified", "layer": "public"}, {"id": "era:research", "type": "Era", "label": "Engineering Education Research", "start": 2015, "end": 2020, "order": 2, "prov": "verified", "layer": "public"}, {"id": "era:graduate", "type": "Era", "label": "M.S. and Energy Systems", "start": 2018, "end": 2019, "order": 3, "prov": "verified", "layer": "public", "note": "B.S.E. May 2018 (GPA 3.7), M.S. May 2019 (GPA 3.8). LEAPS, Kenya microgrid, Scoville application."}, {"id": "person:james_larson", "type": "Person", "label": "James Robert Larson", "self": true, "email": "james@larsongrowth.com", "prov": "verified", "layer": "public"}, {"id": "person:shawn_jordan", "type": "Person", "label": "Shawn S. Jordan", "relation": "co-author", "prov": "verified", "layer": "public", "bio": "Interim Director of the School of Integrated Engineering and Associate Professor of Engineering, Ira A. Fulton Schools of Engineering, ASU. PhD Engineering Education (Purdue, 2010). NSF CAREER awardee; Presidential Early Career Award for Scientists and Engineers, 2017."}, {"id": "person:micah_lande", "type": "Person", "label": "Micah Lande", "relation": "co-author", "prov": "verified", "layer": "public", "bio": "Associate Professor and E.R. Stensaas Chair for Engineering Education, Leslie A. Rose Department of Mechanical Engineering, South Dakota Mines. Directs the Holistic Engineering Lab & Observatory. Formerly ASU. BS/MA/PhD Stanford."}, {"id": "person:steven_weiner", "type": "Person", "label": "Steven Weiner", "relation": "co-author", "prov": "verified", "layer": "public", "bio": "PhD, Human and Social Dimensions of Science and Technology, School for the Future of Innovation in Society, ASU. Interests include STEM education reform and innovation."}, {"id": "person:cecilia_laplace", "type": "Person", "label": "Cecilia La Place", "relation": "co-author", "prov": "verified", "layer": "public", "bio": "PhD. Assistant Research Scientist, STEAM Labs research group, ASU Polytechnic School. Research focuses on asset-based approaches to multidisciplinary and interdisciplinary education.", "note": "Was a research-lineage peer in the previous build. She is now a co-author on James's own paper."}, {"id": "person:darshan_karwat", "type": "Person", "label": "Darshan Karwat", "relation": "co-author", "prov": "verified", "layer": "public", "bio": "The Polytechnic School, Arizona State University. Co-author on the energy justice / technoethics work."}, {"id": "person:wendy_barnard", "type": "Person", "label": "Wendy M. Barnard", "relation": "co-author", "prov": "verified", "layer": "public", "bio": "Assistant Research Professor and Director of the College Research and Evaluation Services Team (CREST), ASU. PhD University of Wisconsin-Madison."}, {"id": "person:adam_carberry", "type": "Person", "label": "Adam Carberry", "relation": "co-author", "prov": "verified", "layer": "public"}, {"id": "person:nathan_johnson", "type": "Person", "label": "Nathan Johnson", "relation": "principal investigator", "prov": "verified", "layer": "public", "bio": "Principal Investigator, Laboratory for Energy and Power Solutions, ASU. PI on the Polytechnic Solar Utilization project."}, {"id": "person:nathan_webster", "type": "Person", "label": "Nathan Webster", "relation": "co-researcher", "prov": "verified", "layer": "public", "bio": "Research Aide alongside James on the shuttle electrification study."}, {"id": "org:asu", "type": "Organization", "label": "Arizona State University", "prov": "verified", "layer": "public"}, {"id": "org:asu_poly", "type": "Organization", "label": "The Polytechnic School, Ira A. Fulton Schools of Engineering, ASU", "parent": "org:asu", "place": "Mesa, AZ", "prov": "verified", "layer": "public"}, {"id": "org:barrett", "type": "Organization", "label": "Barrett, the Honors College, ASU", "prov": "verified", "layer": "public"}, {"id": "org:furi", "type": "Organization", "label": "Fulton Undergraduate Research Initiative (FURI)", "role": "funder", "prov": "verified", "layer": "public"}, {"id": "org:making_engineers", "type": "Organization", "label": "Making Engineers research group", "prov": "verified", "layer": "public", "note": "The group in which James's honors thesis research was conducted."}, {"id": "org:sd_mines", "type": "Organization", "label": "South Dakota Mines", "prov": "verified", "layer": "public"}, {"id": "org:asee", "type": "Organization", "label": "American Society for Engineering Education", "role": "venue", "prov": "verified", "layer": "public"}, {"id": "org:ieee", "type": "Organization", "label": "IEEE", "role": "venue", "prov": "verified", "layer": "public"}, {"id": "org:solarspell", "type": "Organization", "label": "SolarSPELL", "prov": "verified", "layer": "public", "descriptor": "Offline solar-powered digital library for remote classrooms; ASU initiative."}, {"id": "org:merc", "type": "Organization", "label": "Maasai Education Research and Conservation Institute", "prov": "verified", "layer": "public", "place": "Talek, Narok County, Kenya"}, {"id": "org:leaps", "type": "Organization", "label": "Laboratory for Energy and Power Solutions (LEAPS), ASU", "prov": "verified", "layer": "public"}, {"id": "org:steam_labs", "type": "Organization", "label": "STEAM Labs, ASU", "prov": "verified", "layer": "public", "note": "Where he started in 2014, and where Cecilia La Place is now an Assistant Research Scientist. The circle closes."}, {"id": "org:usg", "type": "Organization", "label": "Undergraduate Student Government, ASU Polytechnic", "prov": "verified", "layer": "public"}, {"id": "org:bsa", "type": "Organization", "label": "Boy Scouts of America", "prov": "verified", "layer": "public"}, {"id": "org:srp", "type": "Organization", "label": "Salt River Project (SRP)", "role": "funder", "prov": "verified", "layer": "public", "note": "Funded the Polytechnic Solar Utilization project. The only industry research funder in the record."}, {"id": "role:bs_student", "type": "Role", "label": "B.S. Engineering (Electrical Systems)", "org": "org:asu_poly", "era": "era:undergrad", "start": 2013, "end": 2018, "prov": "verified", "layer": "public", "note": "Self-described in 2016: 'This program, which isn't the same as Electrical Engineering, takes a project-based approach to the curriculum.'"}, {"id": "role:ms_student", "type": "Role", "label": "M.S. Engineering, emphasis in Alternative Energy Systems", "org": "org:asu_poly", "era": "era:graduate", "prov": "verified", "layer": "public", "note": "The hinge in the whole record. It points at energy, not education research, and it is what makes his stated career direction coherent."}, {"id": "role:honors_thesis", "type": "Role", "label": "Honors thesis researcher, Making Engineers research group", "org": "org:barrett", "era": "era:research", "prov": "verified", "layer": "public", "note": "The embedded systems study 'comprised part of Mr. Larson's Barrett, the Honors College honors thesis'."}, {"id": "role:lead_author", "type": "Role", "label": "Lead author across five papers", "org": "org:asu_poly", "era": "era:research", "prov": "verified", "layer": "public", "note": "First-author position on every paper he is on, including both IEEE items."}, {"id": "role:steam_lab_assistant", "type": "Role", "label": "Lab Assistant, STEAM Labs", "org": "org:steam_labs", "era": "era:undergrad", "start": 2014, "end": 2016, "prov": "verified", "layer": "public", "note": "Rube Goldberg machines to teach STEAM to K-12; ran the annual competition. His first job, and the same research group he would publish with."}, {"id": "role:writing_tutor", "type": "Role", "label": "Writing Tutor, Barrett Honors College", "org": "org:barrett", "era": "era:undergrad", "start": 2016, "end": 2018, "prov": "verified", "layer": "public", "note": "'Used the Socratic method to help students structure arguments and analyse texts.' Two and a half years of one-to-one teaching, absent from every recent resume."}, {"id": "role:ugrad_research", "type": "Role", "label": "Undergraduate Research Assistant", "org": "org:asu_poly", "era": "era:research", "start": 2015, "end": 2018, "prov": "verified", "layer": "public"}, {"id": "role:solarspell_lead", "type": "Role", "label": "Student Lead, SolarSPELL", "org": "org:solarspell", "era": "era:undergrad", "start": 2016, "end": 2017, "prov": "verified", "layer": "public", "note": "Led 10 students; travelled to Tonga and Samoa to train Peace Corps Volunteers and local teachers."}, {"id": "role:usg_vp", "type": "Role", "label": "Vice President of Policy, Undergraduate Student Government", "org": "org:usg", "era": "era:undergrad", "start": 2017, "end": 2018, "prov": "verified", "layer": "public", "note": "Analysed utility rate restructuring to allow net metering on the Polytechnic campus. Student government as energy policy work."}, {"id": "role:merc_pm", "type": "Role", "label": "Project Program Manager, Maasai Education Research and Conservation Institute", "org": "org:merc", "era": "era:graduate", "start": 2017, "end": 2019, "prov": "verified", "layer": "public", "note": "Two summers in Kenya. Led the capstone team on a five-year development plan, then returned and installed the solar lighting system."}, {"id": "role:leaps_gra", "type": "Role", "label": "Graduate Research Assistant, LEAPS", "org": "org:leaps", "era": "era:graduate", "start": 2018, "end": 2019, "prov": "verified", "layer": "public", "note": "THE PIVOTAL ROLE. Campus solar evaluation, shuttle fleet electrification, storage benchmarking, and a workforce development bootcamp for utility workers."}, {"id": "role:volunteer_researcher", "type": "Role", "label": "Volunteer Researcher, ASU", "org": "org:asu_poly", "era": "era:research", "start": 2018, "end": 2020, "prov": "verified", "layer": "public", "note": "Unpaid, five hours a week, for two years after graduating. It produced the IEEE journal article."}, {"id": "pub:asee2016", "type": "Publication", "label": "Supporting K-12 Student Self-Direction with a Maker Family Ecosystem", "year": 2016, "venue": "ASEE", "authors": ["person:james_larson", "person:micah_lande", "person:shawn_jordan"], "author_position": 1, "source": "src:asee2016", "prov": "verified", "layer": "public", "rq": "(RQ1) How do the roles in the learning ecosystem of a Young Maker create and define maker family values? (RQ2) How do these values translate to characteristics of successful engineers?"}, {"id": "pub:asee2017", "type": "Publication", "label": "Makers as Adaptive Experts-in-Training: How Maker Design Practices Could Lead to the Engineers of the Future", "year": 2017, "venue": "ASEE", "authors": ["person:james_larson", "person:micah_lande", "person:shawn_jordan", "person:steven_weiner"], "author_position": 1, "source": "src:asee2017", "prov": "verified", "layer": "public", "rq": "What dimensions of design expertise do Young Makers demonstrate through their engineering and making activities?"}, {"id": "pub:ieee_toe", "type": "Publication", "label": "Supporting Self-Directed Learning in a Project-Based Embedded Systems Design Course", "year": 2020, "venue": "IEEE Transactions on Education", "authors": ["person:james_larson", "person:shawn_jordan", "person:micah_lande", "person:steven_weiner"], "author_position": 1, "source": "src:ieee_toe", "prov": "verified", "layer": "public", "citation": "IEEE Trans. Educ., vol. 63, no. 2, pp. 88-97, May 2020, doi: 10.1109/TE.2020.2975358", "rq": "In what ways can a project-based learning approach in an undergraduate embedded systems course facilitate students' self-directed learning?"}, {"id": "pub:ieee_cogdev", "type": "Publication", "label": "Indicators of Developing Adaptive Design Expertise in a Project-Based, Embedded Systems Design Course", "year": 2026, "venue": "IEEE (in publication)", "authors": ["person:james_larson", "person:steven_weiner", "person:micah_lande", "person:cecilia_laplace", "person:shawn_jordan"], "author_position": 1, "source": "src:ieee_cogdev", "prov": "verified", "layer": "public", "rq": "How do students' personal experiences reflect the cognitive development of adaptive design expertise?", "note": "Reworked by former colleagues from the 2018 draft and carried to publication with James still first author. Eight years between draft and print."}, {"id": "pub:laplace_hack", "type": "Publication", "label": "Work In Progress: Building a Bridge Between Hackathons and Software Engineering Capstones Through Adaptive Expertise", "year": 2020, "authors": ["person:cecilia_laplace"], "source": "src:laplace_hack", "prov": "verified", "layer": "public", "external": true}, {"id": "pub:fie2020", "type": "Publication", "label": "Achieving Energy Justice Through Integration of Ethics and Emergent Technology in Energy Systems", "year": 2020, "venue": "Frontiers in Education", "authors": ["person:james_larson", "person:darshan_karwat"], "author_position": 1, "source": "src:fie2020", "prov": "verified", "layer": "public", "note": "First author with one co-author. The only publication in the corpus that is about energy rather than education."}, {"id": "pub:asee2021", "type": "Publication", "label": "Student Recognition, Use, and Understanding of Engineering for One Planet Competencies and Outcomes in Project-Based Learning", "year": 2021, "venue": "ASEE", "paper_id": "33176", "authors": ["person:james_larson", "person:darshan_karwat", "person:adam_carberry", "person:wendy_barnard"], "author_position": 1, "source": "src:asee2021", "prov": "verified", "layer": "public", "note": "Fifth publication, all first-authored. Bridges the education research and the sustainability/energy work."}, {"id": "artifact:codebook", "type": "Artifact", "label": "Adaptive expertise a priori codebook (Expertise / Design Thinking / Transfer)", "source": "src:ieee_cogdev", "prov": "verified", "layer": "public", "descriptor": "Codebook built from Hatano & Inagaki, Schwartz et al. and Neeley, used for deductive thematic analysis of ten critical incident interviews. Survived from the 2018 draft into the published version."}, {"id": "artifact:solarspell_device", "type": "Artifact", "label": "SolarSPELL offline solar-powered digital library", "org": "org:solarspell", "source": "src:scoville", "prov": "verified", "layer": "public", "descriptor": "Designed, produced and distributed for remote classrooms across Pacific Island Nations; deployed and trained on in Tonga and Samoa."}, {"id": "artifact:maasai_solar", "type": "Artifact", "label": "Solar generation and battery storage lighting system, Maasai Mara", "org": "org:merc", "source": "src:resume2024", "prov": "verified", "layer": "public", "descriptor": "Designed and installed across the community centre facilities, with local staff trained on operation and maintenance and a five-year microgrid expansion plan."}, {"id": "artifact:bootcamp", "type": "Artifact", "label": "Microgrid design and operation bootcamp", "org": "org:leaps", "source": "src:scoville", "prov": "verified", "layer": "public", "descriptor": "Curriculum designed, organised and hosted for utility workers new to solar, veterans, and people transitioning out of fossil fuel jobs.", "note": "THE ARTIFACT THAT CHANGES THE READING OF THE WHOLE GRAPH. In 2019 he built and ran workforce retraining for energy workers in transition. His 2026 author bio describes this as an interest."}, {"id": "artifact:eop_framework", "type": "Artifact", "label": "Engineering for One Planet (EOP) framework workshop materials", "source": "src:eop_deck", "prov": "verified", "layer": "public", "descriptor": "Facilitation deck gathering revisions to the EOP sustainability competency framework, including ABET/UN SDG alignment and JEDI embedding."}, {"id": "artifact:shuttle_report", "type": "Artifact", "label": "Shuttle Electrification and Solar Utilization Report", "org": "org:leaps", "source": "src:cw_shuttle", "prov": "verified", "layer": "public", "descriptor": "Load forecasts and demand management for MW charging; used idle time at stops as fast-charging opportunity."}, {"id": "artifact:eagle_project", "type": "Artifact", "label": "Eagle Scout service project: shot put and discus platforms", "org": "org:bsa", "source": "src:eagle_essay", "prov": "verified", "layer": "public", "descriptor": "Built for a Nevada school whose teams had to drive down the mountain for facilities. Broke ground without municipal clearance, was halted, presented to the landowners, and re-scoped to meet their security and maintenance concerns."}, {"id": "thy:adaptive_expertise", "type": "Theory", "label": "Adaptive Expertise", "origin": "Hatano & Inagaki (1984)", "prov": "verified", "layer": "public", "gloss": "Ability to apply knowledge flexibly to novel problems in unfamiliar contexts. Contrasted with routine expertise: fast, accurate, automatic, brittle."}, {"id": "thy:routine_expertise", "type": "Theory", "label": "Routine Expertise", "origin": "Hatano & Inagaki (1984)", "prov": "verified", "layer": "public"}, {"id": "thy:efficiency_innovation", "type": "Theory", "label": "Efficiency / Innovation dimensions of transfer", "origin": "Schwartz, Bransford & Sears (2005)", "prov": "verified", "layer": "public"}, {"id": "thy:oac", "type": "Theory", "label": "Optimal Adaptability Corridor", "origin": "Schwartz et al. (2005)", "prov": "verified", "layer": "public"}, {"id": "thy:design_dimensions", "type": "Theory", "label": "Active / Abstractive / Adaptive dimensions of design thinking", "origin": "Neeley (2007)", "prov": "verified", "layer": "public"}, {"id": "thy:transfer_in_out", "type": "Theory", "label": "Transfer In / Transfer Out", "prov": "verified", "layer": "public", "gloss": "Drawing on prior coursework versus reaching past what a project strictly required. Both directions evidenced in the published study."}, {"id": "thy:learning_ecology", "type": "Theory", "label": "Learning Ecology", "origin": "Barron", "prov": "verified", "layer": "public"}, {"id": "thy:sdl", "type": "Theory", "label": "Self-Directed Learning", "prov": "verified", "layer": "public"}, {"id": "thy:lifelong_learning", "type": "Theory", "label": "Lifelong Learning / ABET strategic learning", "prov": "verified", "layer": "public", "gloss": "The outcome everyone endorses and nobody can measure. His framing problem across the whole body of work."}, {"id": "thy:jit_learning", "type": "Theory", "label": "Just-in-Time Learning", "prov": "verified", "layer": "public"}, {"id": "thy:self_efficacy", "type": "Theory", "label": "Self-Efficacy", "origin": "Bandura", "prov": "verified", "layer": "public", "gloss": "Named in the 2020 IEEE article as the mechanism by which the learning ecology produces self-direction."}, {"id": "thy:absorbent_mind", "type": "Theory", "label": "Absorbent Mind", "origin": "Montessori", "prov": "verified", "layer": "public"}, {"id": "thy:energy_justice", "type": "Theory", "label": "Energy Justice", "origin": "Larson & Karwat (FIE 2020)", "prov": "verified", "layer": "public", "gloss": "Emergent energy technologies must be analysed and implemented ethically. Decentralised generation requires omnidirectional power flow rather than hierarchical, and the political and social uncertainties must be addressed before a system the public depends on is changed."}, {"id": "thy:geels_mlp", "type": "Theory", "label": "Multi-Level Perspective on sociotechnical transitions", "origin": "Frank Geels", "prov": "verified", "layer": "public", "gloss": "Transitions as alignments between niche, regime and landscape levels. 'Radically new technologies have a hard time to break through, because regulations, infrastructure, user practices, maintenance networks are aligned to the existing technology.'", "note": "He read this closely in 2019 and built a research design around it. It is the missing theoretical bridge between his education research and his energy work: both are about how an entrenched system resists change."}, {"id": "thy:technoethics", "type": "Theory", "label": "Technoethics", "origin": "Mario Bunge (1977)", "prov": "verified", "layer": "public", "gloss": "The ethical evaluation of technology as a first-class design consideration rather than an afterthought."}, {"id": "thy:trl", "type": "Theory", "label": "Technology Readiness Level", "origin": "NASA/industry standard", "prov": "verified", "layer": "public", "gloss": "Used in the FIE paper to structure a survey of atomic energy technologies from lowest TRL to market-ready."}, {"id": "thy:eop", "type": "Theory", "label": "Engineering for One Planet (EOP) competency framework", "origin": "EOP initiative", "prov": "verified", "layer": "public", "gloss": "Nine sustainability competencies for engineering curricula. He studied student recognition of them and facilitated workshops revising the framework itself."}, {"id": "thy:winner_artifacts", "type": "Theory", "label": "Technology as social ordering", "origin": "Langdon Winner", "prov": "verified", "layer": "public", "gloss": "Cited in the nuclear ethics work: technologies reweave the fabric of society rather than sitting neutrally inside it."}, {"id": "ctb:nonsequential_development", "type": "Contribution", "label": "Non-sequential development of expertise", "origin": "Larson et al. (IEEE, in publication)", "prov": "verified", "layer": "public", "original": true, "gloss": "ORIGINAL CONTRIBUTION, AND THE ONE THAT SURVIVED. Indicators of routine and adaptive expertise surfaced dynamically rather than sequentially, and in several cases within the same student. This contradicts the directional assumption in both Hatano & Inagaki and Schwartz et al., who imply novices progress toward expertise in order."}, {"id": "ctb:neeley_validation", "type": "Contribution", "label": "First empirical classroom validation of Neeley's dimensions", "origin": "Larson et al. (IEEE, in publication)", "prov": "verified", "layer": "public", "original": true, "gloss": "Neeley's three dimensions came from dissertation work, never validated against empirical classroom data. This study supplies that."}, {"id": "ctb:activation_energy", "type": "Contribution", "label": "Activation energy of a learning resource", "origin": "Larson (IEEE ToE 2020)", "prov": "verified", "layer": "public", "original": true, "gloss": "ORIGINAL CONTRIBUTION, PUBLISHED. Lower the activation energy on peers and repositories, raise it on the instructor, and learners explore the ecology instead of queuing for the expert. Transfers well beyond education."}, {"id": "ctb:maker_family_values", "type": "Contribution", "label": "Maker Family Values", "origin": "Larson (ASEE 2016)", "prov": "verified", "layer": "public", "original": true, "gloss": "ORIGINAL CONTRIBUTION, PUBLISHED. The educational values held by whoever surrounds a young maker, shown to be Montessori-aligned and child-centred."}, {"id": "ctb:ecology_roles", "type": "Contribution", "label": "Roles in a learner's ecology: facilitator, teacher, peer/near-peer, designer, client", "origin": "Larson (ASEE 2016)", "prov": "verified", "layer": "public", "original": true}, {"id": "ctb:proactive_regulation", "type": "Contribution", "label": "Proactive rather than reactive technology regulation", "origin": "Larson (2019 Scoville policy essay)", "prov": "verified", "layer": "public", "original": true, "gloss": "'Technology will advance with or without legislation, and authoritarian systems thrive in a reactive political and regulatory system.' Argues the energy transition is the best available opportunity to change how technology is introduced to the public."}, {"id": "prn:workforce_transition", "type": "Principle", "label": "Workforce development for fields in transition", "origin": "Larson (stated interest, 2026)", "prov": "verified", "layer": "public", "original": true, "gloss": "His own stated direction: helping engineers and technicians adapt to new technologies, particularly in energy and power. Adaptive expertise is the theory of exactly this, applied to working adults instead of students. Nothing in the record connects them yet except him."}, {"id": "prn:individual_in_institutions", "type": "Principle", "label": "The individual as the unit that changes institutions", "origin": "Larson (2014-2017 coursework)", "prov": "verified", "layer": "public", "original": true, "gloss": "Sustained across four philosophy papers: 'Every sort of radical change to the social and political landscape of an era is preceded by a change in individual philosophy.' The philosophical root of everything he later called self-direction."}, {"id": "prn:pragmatic_agency", "type": "Principle", "label": "Pragmatic agency over ideal agency", "origin": "Larson (2017 coursework)", "prov": "verified", "layer": "public", "original": true, "gloss": "Repeatedly prefers the workable to the pure: Nietzsche's overman is 'more realistic' than Marx's communist; Camus 'adapts the Overman to the absurd world of the weak, by embracing the weak'; Beauvoir's activist is 'better equipped than Malcolm X's black nationalist to pragmatically escape oppression.' He picks the framework that survives contact with actual people."}, {"id": "prn:community_as_security", "type": "Principle", "label": "Community as the precondition for security", "origin": "Larson (2019 Scoville essay)", "prov": "verified", "layer": "public", "original": true, "gloss": "'A strong sense of community is necessary for people to feel secure in their homes... Peace of mind can only be brought about through a secure community, and technology can be applied to strengthen communal security.' Connects a Nevada mountain town to a Kenyan village explicitly."}, {"id": "prn:teach_adaptation", "type": "Principle", "label": "Teach people to improve their situation with whatever technology is available", "origin": "Larson (2018 MORE statement)", "prov": "verified", "layer": "public", "original": true, "gloss": "'Making technology accessible to people to not just use, but to understand and reinvent is crucial to their holistic understanding of how they can adapt knowledge to other situations they face.' This is adaptive expertise, stated in his own words, about communities rather than students, before the adaptive expertise papers were finished."}, {"id": "prn:self_contained_solution", "type": "Principle", "label": "Self-contained solutions are what make deployment sustainable", "origin": "Larson (2019 Scoville essay)", "prov": "verified", "layer": "public", "original": true, "gloss": "'The SolarSPELL was effectively implemented across the Pacific because it is a self-contained solution, it was designed specifically for these communities and that is what made it sustainable.' A design principle he derived from fieldwork and has never published."}, {"id": "prn:facilitated_action", "type": "Principle", "label": "Facilitating action rather than performing it", "origin": "Larson (2018 Eagle Scout essay)", "prov": "verified", "layer": "public", "original": true, "gloss": "'It was my ability to convince people that this project was worthwhile that got it done... I had merely facilitated action, and guided the community in bettering itself. No one can ever really succeed entirely on their own, and identifying work that inspires others to help is what I understand to be my strongest entrepreneurial characteristic.' Written at 21 about being 17."}, {"id": "meth:deductive_thematic", "type": "Method", "label": "Deductive thematic analysis", "origin": "Braun & Clarke; Swain; Crabtree & Miller", "prov": "verified", "layer": "public", "detail": "The methodological core of the published study, using an a priori codebook."}, {"id": "meth:critical_incident", "type": "Method", "label": "Critical Incident Technique interviews", "origin": "Flanagan (1954)", "prov": "verified", "layer": "public", "detail": "Ten semi-structured interviews, one student from each of ten design teams, Fall 2017 cohort, conducted after the semester concluded."}, {"id": "meth:artifact_elicitation", "type": "Method", "label": "Artifact Elicitation interviews", "origin": "Douglas, Jordan, Lande & Bumbaco (2015)", "prov": "verified", "layer": "public", "detail": "24 Young Makers aged 8-17 and 12 adult Makers at the NY and Bay Area Maker Faires, 2013-2015."}, {"id": "meth:codebook", "type": "Method", "label": "A priori codebook development", "prov": "verified", "layer": "public"}, {"id": "meth:max_variation", "type": "Method", "label": "Maximum variation purposeful sampling", "origin": "Patton (2002)", "prov": "verified", "layer": "public"}, {"id": "meth:stratified_purposeful", "type": "Method", "label": "Stratified purposeful sampling", "prov": "verified", "layer": "public", "detail": "Strata explicitly designed so underrepresented groups by ethnicity and gender would be in the dataset."}, {"id": "meth:triangulation", "type": "Method", "label": "Triangulation of instructor intent with learner experience", "prov": "verified", "layer": "public"}, {"id": "meth:interview_protocol_design", "type": "Method", "label": "Interview protocol design and piloting", "prov": "verified", "layer": "public", "detail": "Protocol built from Neeley's framework and revised against pilot interviews. The full protocol is published as an appendix."}, {"id": "meth:mixed_methods", "type": "Method", "label": "Mixed-methods design (survey plus open-response coding)", "prov": "verified", "layer": "public", "detail": "The EOP study pairs a correlational analysis of fixed-item responses with deductive and inductive coding of open text. It is the only quantitative work in his record."}, {"id": "meth:techno_economic", "type": "Method", "label": "Techno-economic feasibility analysis", "prov": "verified", "layer": "public", "detail": "State-of-charge analysis, initial and operational expense aggregation, payback period calculation, avoided-cost comparison against utility rate plans."}, {"id": "skill:qual_research", "type": "Skill", "label": "Qualitative research design and execution", "level": "demonstrated", "prov": "verified", "layer": "public"}, {"id": "skill:interviewing", "type": "Skill", "label": "Semi-structured and critical-incident interviewing", "level": "demonstrated", "prov": "verified", "layer": "public", "detail": "46 documented interviews across three studies, with participants from age 8 to faculty."}, {"id": "skill:coding_analysis", "type": "Skill", "label": "Thematic coding and codebook analysis", "level": "demonstrated", "prov": "verified", "layer": "public"}, {"id": "skill:academic_writing", "type": "Skill", "label": "Peer-reviewed academic writing", "level": "demonstrated", "prov": "verified", "layer": "public", "detail": "First author on four published papers including two IEEE items, the first begun as an undergraduate."}, {"id": "skill:theory_building", "type": "Skill", "label": "Theory building and construct naming", "level": "demonstrated", "prov": "verified", "layer": "public"}, {"id": "skill:curriculum_analysis", "type": "Skill", "label": "Curriculum and learning-environment analysis", "level": "demonstrated", "prov": "verified", "layer": "public"}, {"id": "skill:instructional_design", "type": "Skill", "label": "Instructional and program design", "level": "demonstrated", "prov": "inferred", "layer": "public"}, {"id": "skill:embedded_systems", "type": "Skill", "label": "Embedded systems design", "level": "trained", "prov": "verified", "layer": "public"}, {"id": "skill:pcb_prototyping", "type": "Skill", "label": "PCB design, programming, soldering, iterative prototyping", "level": "trained", "prov": "verified", "layer": "public"}, {"id": "skill:alt_energy", "type": "Skill", "label": "Alternative energy systems", "level": "credentialed", "prov": "verified", "layer": "public", "detail": "M.S. emphasis. The only formally credentialed technical domain in the record, and the least represented anywhere else in it."}, {"id": "skill:writing_for_lay", "type": "Skill", "label": "Writing for non-academic audiences", "level": "demonstrated", "prov": "inferred", "layer": "public"}, {"id": "skill:microgrid", "type": "Skill", "label": "Microgrid modelling and design (Xendee, HOMER)", "level": "professional", "prov": "verified", "layer": "public", "detail": "From LEAPS and the Kenya work forward; named on every resume since 2018."}, {"id": "skill:stakeholder_facilitation", "type": "Skill", "label": "Stakeholder requirement gathering and facilitation", "level": "demonstrated", "prov": "verified", "layer": "public", "detail": "Peace Corps volunteers and Pacific Island teachers; Maasai community leaders; parents, faculty and tribal leaders in a school district search; utility workers in a retraining bootcamp."}, {"id": "skill:curriculum_design", "type": "Skill", "label": "Curriculum design and delivery for adult learners", "level": "demonstrated", "prov": "verified", "layer": "public", "detail": "Microgrid bootcamp for utility workers and fossil-fuel-transitioning workers; K-12 STEAM programming; two and a half years as a writing tutor."}, {"id": "skill:philosophy", "type": "Skill", "label": "Philosophical argument and textual analysis", "level": "demonstrated", "prov": "verified", "layer": "public", "detail": "Nine coursework papers 2014-2019 across ancient, modern, existentialist and critical theory, plus two and a half years tutoring it Socratically."}, {"id": "skill:energy_policy", "type": "Skill", "label": "Energy policy and regulatory analysis", "level": "demonstrated", "prov": "verified", "layer": "public", "detail": "Net metering restructuring at ASU; federalism and power regulation; nuclear non-proliferation and technoethics; DOE Connected Communities."}, {"id": "skill:techno_economic", "type": "Skill", "label": "Techno-economic analysis (payback, load profiling, rate structures)", "level": "demonstrated", "prov": "verified", "layer": "public", "detail": "Payback-period modelling across nine shuttle-charger combinations, load profiles for MW fast-charging, and avoided-cost analysis against SRP E-32 and E-36 utility rate plans."}, {"id": "skill:survey_research", "type": "Skill", "label": "Survey design and correlational analysis", "level": "demonstrated", "prov": "verified", "layer": "public", "detail": "Fixed-item and open-ended instrument across 117 students, with a correlation matrix at p<.001 and mixed deductive/inductive coding of 221 open responses."}, {"id": "val:self_direction", "type": "Value", "label": "Self-direction / autonomy in learning", "prov": "verified", "layer": "public", "gloss": "The subject of three papers and the premise of everything else.", "persistence": 1.5677, "salience": 0.442, "n_expressions": 9, "eras_present": ["era:pre_college", "era:research", "era:undergrad"], "external_attestations": 0, "persistence_norm": 0.7903, "quadrant": "DORMANT"}, {"id": "val:lifelong_learning", "type": "Value", "label": "Learning as a lifelong stance", "prov": "verified", "layer": "public", "persistence": 1.7594, "salience": 0.6815, "n_expressions": 5, "eras_present": ["era:graduate", "era:research", "era:undergrad"], "external_attestations": 0, "persistence_norm": 0.8869, "quadrant": "CORE"}, {"id": "val:adaptability", "type": "Value", "label": "Adaptability over specialisation", "prov": "verified", "layer": "public", "persistence": 1.534, "salience": 1.0, "n_expressions": 7, "eras_present": ["era:graduate", "era:research"], "external_attestations": 2, "persistence_norm": 0.7733, "quadrant": "EMERGING"}, {"id": "val:people_over_systems", "type": "Value", "label": "People's lived experience over system metrics", "prov": "verified", "layer": "public", "gloss": "A consistent methodological choice: he keeps interviewing individuals when he could have surveyed populations.", "persistence": 1.9594, "salience": 0.7659, "n_expressions": 7, "eras_present": ["era:research", "era:undergrad"], "external_attestations": 1, "persistence_norm": 0.9878, "quadrant": "CORE"}, {"id": "val:access", "type": "Value", "label": "Access and inclusion", "prov": "verified", "layer": "public", "persistence": 1.9837, "salience": 0.4785, "n_expressions": 8, "eras_present": ["era:graduate", "era:research", "era:undergrad"], "external_attestations": 1, "persistence_norm": 1.0, "quadrant": "DORMANT"}, {"id": "val:practical_utility", "type": "Value", "label": "Research should be usable by the people it describes", "prov": "verified", "layer": "public", "persistence": 1.8888, "salience": 0.7439, "n_expressions": 7, "eras_present": ["era:graduate", "era:research"], "external_attestations": 0, "persistence_norm": 0.9522, "quadrant": "CORE"}, {"id": "val:transition_support", "type": "Value", "label": "Standing with people whose field is changing under them", "prov": "verified", "layer": "public", "gloss": "His own stated interest in 2026. The through-line from studying students facing novel problems to helping working engineers face obsolescence.", "persistence": 1.963, "salience": 0.7007, "n_expressions": 7, "eras_present": ["era:graduate", "era:research"], "external_attestations": 0, "persistence_norm": 0.9896, "quadrant": "CORE"}, {"id": "val:naming_things", "type": "Value", "label": "Naming what has no name yet", "prov": "inferred", "layer": "public", "gloss": "Inferred from behaviour, not statement. Note what happened to it: four of the constructs this value produced were cut from the published version.", "persistence": 1.5455, "salience": 0.6687, "n_expressions": 9, "eras_present": ["era:graduate", "era:pre_college", "era:research"], "external_attestations": 0, "persistence_norm": 0.7791, "quadrant": "CORE"}, {"id": "val:failure_as_material", "type": "Value", "label": "Failure as a legitimate part of process", "prov": "verified", "layer": "public", "persistence": 1.1804, "salience": 0.2575, "n_expressions": 4, "eras_present": ["era:pre_college", "era:research"], "external_attestations": 1, "persistence_norm": 0.595, "quadrant": "INCIDENTAL"}, {"id": "val:individual_agency", "type": "Value", "label": "The individual's power to change the institution around them", "prov": "verified", "layer": "public", "gloss": "The oldest documented value in the graph and the root of the rest. Four philosophy papers argue it directly; the Eagle Scout project enacts it; student government, net metering and the bootcamp are it applied.", "persistence": 1.5223, "salience": 0.3352, "n_expressions": 8, "eras_present": ["era:graduate", "era:pre_college", "era:undergrad"], "external_attestations": 0, "persistence_norm": 0.7674, "quadrant": "INCIDENTAL"}, {"id": "val:community_infrastructure", "type": "Value", "label": "Community as the thing infrastructure is for", "prov": "verified", "layer": "public", "gloss": "Explicitly links a Nevada mountain town to a Kenyan village. Drove the choice of energy systems as a field.", "persistence": 1.4166, "salience": 0.3459, "n_expressions": 6, "eras_present": ["era:graduate", "era:pre_college", "era:undergrad"], "external_attestations": 0, "persistence_norm": 0.7141, "quadrant": "INCIDENTAL"}, {"id": "val:energy_justice_val", "type": "Value", "label": "Energy transition must be just, not merely fast", "prov": "verified", "layer": "public", "persistence": 0.9815, "salience": 0.4791, "n_expressions": 7, "eras_present": ["era:graduate"], "external_attestations": 0, "persistence_norm": 0.4948, "quadrant": "EMERGING"}, {"id": "val:pragmatism", "type": "Value", "label": "The workable over the pure", "prov": "verified", "layer": "public", "gloss": "A consistent philosophical preference that later shows up as method: he keeps choosing the framework that survives contact with real people.", "persistence": 0.8283, "salience": 0.2079, "n_expressions": 5, "eras_present": ["era:graduate", "era:undergrad"], "external_attestations": 0, "persistence_norm": 0.4176, "quadrant": "INCIDENTAL"}, {"id": "mot:understanding_how_people_learn", "type": "Motivation", "label": "Understanding how people actually learn", "prov": "verified", "layer": "public"}, {"id": "mot:building_frameworks", "type": "Motivation", "label": "Building frameworks that outlive the engagement", "prov": "inferred", "layer": "public"}, {"id": "mot:keeping_people_employable", "type": "Motivation", "label": "Keeping people employable as their field changes", "prov": "verified", "layer": "public"}, {"id": "aud:engineers_in_transition", "type": "Audience", "label": "Engineers and technicians whose technology is changing", "prov": "verified", "layer": "public"}, {"id": "aud:engineering_educators", "type": "Audience", "label": "Engineering educators and curriculum designers", "prov": "verified", "layer": "public"}, {"id": "aud:young_makers", "type": "Audience", "label": "K-12 makers and their families", "prov": "verified", "layer": "public"}, {"id": "aud:learning_orgs", "type": "Audience", "label": "Organisations designing learning experiences", "prov": "inferred", "layer": "public"}, {"id": "prob:obsolescence", "type": "Problem", "label": "People's skills going obsolete faster than they can retrain", "prov": "verified", "layer": "public"}, {"id": "prob:unprepared_for_novelty", "type": "Problem", "label": "Training prepares people for known problems, not new ones", "prov": "verified", "layer": "public"}, {"id": "prob:unmeasurable_outcomes", "type": "Problem", "label": "The outcomes that matter most are the hardest to measure", "prov": "verified", "layer": "public"}, {"id": "prob:experience_not_legible", "type": "Problem", "label": "People hold experience they cannot make legible to others", "prov": "inferred", "layer": "public"}, {"id": "proc:qual_inquiry", "type": "Process", "label": "Deep qualitative inquiry into individual experience", "prov": "verified", "layer": "public"}, {"id": "proc:framework_from_evidence", "type": "Process", "label": "Induce a framework from evidence, then name it", "prov": "verified", "layer": "public"}, {"id": "proc:iterative_prototyping", "type": "Process", "label": "Iterative prototyping / learn by building", "prov": "verified", "layer": "public"}, {"id": "proc:scaffolded_self_direction", "type": "Process", "label": "Scaffold, then get out of the way", "prov": "verified", "layer": "public"}, {"id": "place:project_based_program", "type": "Place", "label": "Project-based, low-hierarchy environments", "prov": "verified", "layer": "public"}, {"id": "place:research_group", "type": "Place", "label": "Small research group with faculty collaborators", "prov": "verified", "layer": "public"}, {"id": "place:energy_sector", "type": "Place", "label": "Energy and power sector", "prov": "verified", "layer": "public"}, {"id": "purp:adapt_not_obsolete", "type": "Purpose", "label": "Help people stay capable while the ground moves under them", "prov": "inferred", "layer": "public", "gloss": "The one sentence covering both the research and the stated direction. Students facing problems they had never seen, and engineers facing technologies that did not exist when they trained, are the same problem at different ages."}, {"id": "niche:energy_workforce", "type": "Niche", "label": "Adaptive-expertise-informed workforce development for the energy transition", "status": "stated", "prov": "verified", "layer": "public", "gloss": "Where his M.S., his research programme and his stated interest actually intersect. Verified from his own author biography."}, {"id": "niche:learning_research", "type": "Niche", "label": "Engineering education research", "status": "proven", "prov": "verified", "layer": "public", "gloss": "Demonstrably occupied: four published papers. Whether he wants to continue occupying it is a separate question."}, {"id": "gap:pre_college", "type": "Evidence", "label": "[GAP] College application essays and pre-2013 material", "prov": "prompt", "layer": "public", "priority": 1, "question": "Persistence scoring still starts at 2013. Adding pre-college material remains the highest-leverage ingestion for the value layer."}, {"id": "gap:prior_resumes", "type": "Evidence", "label": "[GAP] Every prior resume, in date order", "prov": "prompt", "layer": "public", "priority": 1, "question": "Old resumes record how you saw yourself at each point, which is what lets the graph tell a value you dropped from one you never held."}, {"id": "gap:technical_depth", "type": "Skill", "label": "[GAP] What you have actually built", "prov": "prompt", "layer": "public", "priority": 2, "question": "You hold an M.S. in Alternative Energy Systems and the record contains not one artifact from it. No thesis, no project, no system. For the energy-transition claim this is the missing leg."}, {"id": "gap:ms_thesis", "type": "Artifact", "label": "[GAP] M.S. thesis or capstone", "prov": "prompt", "layer": "public", "priority": 2, "question": "Was there a thesis, report or project? Title and topic at minimum."}, {"id": "gap:teaching", "type": "Evidence", "label": "[GAP] Teaching, TA, or facilitation history", "prov": "prompt", "layer": "public", "priority": 2, "question": "Given the subject matter it would be odd if there were none, and nothing in the corpus records it."}, {"id": "gap:degree_naming", "type": "Evidence", "label": "[GAP] Your degree has three different names across your own documents", "prov": "prompt", "layer": "public", "priority": 1, "question": "The 2024 resume says B.S.E. 'Engineering of Electrical Systems with a focus in Alternative Energy Systems' and M.S. 'Engineering of Electrical Systems'. The 2025 resume says both are 'Systems Engineering (Electrical)'. The 2026 resume says both are 'Engineering (Electrical Systems)'. The IEEE author biography says the M.S. is 'Engineering with an emphasis in Alternative Energy Systems'. Which is the conferred title, and which degree carries the alternative energy emphasis? A background check will find this."}, {"id": "gap:bootcamp_detail", "type": "Artifact", "label": "[GAP] The bootcamp curriculum itself", "prov": "prompt", "layer": "public", "priority": 1, "question": "You designed, organised and hosted retraining for utility workers, veterans and fossil-fuel-transitioning workers. How many cohorts, how many people, what was in it, what happened to them? This is the single highest-value missing artifact in the graph \u2014 it is the evidence for your best claim and it is one resume line."}, {"id": "gap:capstone", "type": "Artifact", "label": "[GAP] The Kenya capstone five-year development plan", "prov": "prompt", "layer": "public", "priority": 2, "question": "You led the capstone team that produced it. Is the document still available?"}, {"id": "gap:more_outcome", "type": "Evidence", "label": "[GAP] What happened to the MORE grant and the Scoville application", "prov": "prompt", "layer": "public", "priority": 3, "question": "Both applications are in the folder. Neither outcome is recorded. Awards are evidence; rejections are also information about what you were reaching for."}, {"id": "gap:teaching_absent", "type": "Evidence", "label": "[GAP] Why teaching disappeared from your resumes", "prov": "prompt", "layer": "public", "priority": 2, "question": "STEAM Labs, two and a half years of Socratic tutoring, the microgrid bootcamp, and K-12 Rube Goldberg competitions all appear on the 2024 resume and none appear on the 2025 or 2026 ones. If you are aiming at energy workforce development, you have cut the exact evidence that supports it."}, {"id": "gap:quant_hidden", "type": "Evidence", "label": "[GAP] Your only quantitative study is invisible", "prov": "prompt", "layer": "public", "priority": 1, "question": "The EOP paper is a mixed-methods study: 117 students, a correlation matrix significant at p<.001, and 221 coded open responses. Every claim in this graph describes you as a qualitative researcher, and your resumes do not mention the study at all. If you are targeting product or analytics roles, this is the single most relevant thing you have published and it is missing from every document you send out."}, {"id": "gap:shuttle_credit", "type": "Evidence", "label": "[GAP] What exactly was yours in the shuttle report", "prov": "prompt", "layer": "public", "priority": 2, "question": "You are listed as Research Aide under PI Nathan Johnson, alongside Nathan Webster. The report contains substantial modelling. Which sections did you produce? Without that, the graph can only tag this collective, which weakens it for resume use."}, {"id": "ev:two_ieee_first_author", "label": "First author on two IEEE publications", "detail": "IEEE Transactions on Education (2020, vol. 63 no. 2, pp. 88-97) and a second IEEE paper in publication in 2026. Lead author ahead of three to four faculty co-authors on both.", "source": "src:ieee_cogdev", "era": "era:research", "year": 2026, "efficacy": "mastery", "agency": "collective", "kolb": "CE", "strength": 5, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:work_carried_to_print", "label": "Former colleagues reworked his study and carried it to publication with him still first author", "detail": "The 2018 draft was reworked eight years later by Weiner, Lande, La Place and Jordan and is now in publication with IEEE. His first-author position was retained.", "source": "src:ieee_cogdev", "era": "era:research", "year": 2026, "efficacy": "social_persuasion", "agency": "proxy", "kolb": "RO", "strength": 5, "prov": "verified", "layer": "public", "note": "The strongest attestation in the record. Four people, one of them now an Interim Director, spent effort on an eight-year-old draft and left your name first. That is a judgement about the work, made without you in the room.", "type": "Evidence"}, {"id": "ev:honors_thesis", "label": "The study formed part of his Barrett Honors College honors thesis", "detail": "Conducted in the Making Engineers research group; supported by the Fulton Undergraduate Research Initiative and Barrett, the Honors College.", "source": "src:ieee_cogdev", "era": "era:research", "year": 2018, "efficacy": "mastery", "agency": "personal", "kolb": "CE", "strength": 4, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:two_degrees", "label": "B.S. Engineering (Electrical Systems) and M.S. Engineering, emphasis Alternative Energy Systems", "detail": "Both from The Polytechnic School, Ira A. Fulton Schools of Engineering, Arizona State University.", "source": "src:ieee_cogdev", "era": "era:graduate", "year": 2020, "efficacy": "mastery", "agency": "personal", "kolb": "CE", "strength": 4, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:contradicted_canon", "label": "Produced empirical evidence contradicting a directional assumption in two canonical frameworks", "detail": "Indicators of routine and adaptive expertise surfaced dynamically rather than sequentially, and in several cases within the same student, against the progression implied by Hatano & Inagaki and Schwartz et al.", "source": "src:ieee_cogdev", "era": "era:research", "year": 2026, "efficacy": "mastery", "agency": "collective", "kolb": "AC", "strength": 5, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:validated_neeley", "label": "Supplied the first empirical classroom validation of Neeley's design thinking dimensions", "detail": "Neeley's three dimensions were derived from dissertation work and never tested against classroom data.", "source": "src:ieee_cogdev", "era": "era:research", "year": 2026, "efficacy": "mastery", "agency": "collective", "kolb": "AC", "strength": 4, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:activation_energy_design", "label": "Articulated a design principle for learning environments: manage activation energy, not content delivery", "detail": "A buffer of peers, TAs and a curated repository raises the cost of reaching the instructor, which pushes learners to explore the ecology and build self-efficacy.", "source": "src:ieee_toe", "era": "era:research", "year": 2020, "efficacy": "mastery", "agency": "personal", "kolb": "AC", "strength": 5, "prov": "verified", "layer": "public", "note": "Transferable well past education. It is a claim about how people seek help under cost, which is an onboarding and a workforce problem too.", "type": "Evidence"}, {"id": "ev:ten_critical_incident", "label": "Designed, piloted and ran ten critical-incident interviews, and published the protocol", "detail": "Protocol built from Neeley's framework, revised against pilot interviews, run after the semester so students could reflect on the whole experience. Published in full as an appendix.", "source": "src:ieee_cogdev", "era": "era:research", "year": 2026, "efficacy": "mastery", "agency": "personal", "kolb": "AE", "strength": 5, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:36_interviews_makers", "label": "Conducted artifact elicitation interviews with 36 makers aged 8 to adult", "detail": "24 Young Makers aged 8-17 and 12 adult Makers at the New York and Bay Area Maker Faires across 2013, 2014 and 2015.", "source": "src:asee2017", "era": "era:research", "year": 2017, "efficacy": "mastery", "agency": "collective", "kolb": "CE", "strength": 4, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:sampling_for_inclusion", "label": "Designed sampling strata specifically to include underrepresented participants", "detail": "Stratified purposeful sampling with explicit strata for ethnicity and gender, on the argument that representative sampling would miss relevant educational pathways.", "source": "src:asee2017", "era": "era:research", "year": 2017, "efficacy": "mastery", "agency": "personal", "kolb": "AC", "strength": 4, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:identified_family_roles", "label": "Identified and named the roles constituting a young learner's support ecology", "detail": "Facilitator, teacher, peer/near-peer, designer and client, derived from interviews and shown to be Montessori-aligned.", "source": "src:asee2016", "era": "era:research", "year": 2016, "efficacy": "mastery", "agency": "personal", "kolb": "AC", "strength": 4, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:faculty_coauthors", "label": "Published alongside a PECASE recipient, a named chair, and a Stanford-trained design education researcher", "detail": "Shawn Jordan (PECASE 2017, now Interim Director of the School of Integrated Engineering), Micah Lande (E.R. Stensaas Chair, South Dakota Mines), Steven Weiner and Cecilia La Place.", "source": "src:ieee_cogdev", "era": "era:research", "year": 2026, "efficacy": "vicarious", "agency": "proxy", "kolb": "CE", "strength": 4, "prov": "verified", "layer": "public", "note": "For bios and pitches. Not a resume bullet; it claims their credit.", "type": "Evidence"}, {"id": "ev:chose_project_based", "label": "Chose a project-based engineering program deliberately and defended the choice in print at twenty", "detail": "'This program, which isn't the same as Electrical Engineering, takes a project-based approach to the curriculum... excited to have this opportunity to offer a student's perspective on the future of engineering education.'", "source": "src:asee2016", "era": "era:undergrad", "year": 2016, "efficacy": "physiological", "agency": "personal", "kolb": "RO", "strength": 3, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:stated_direction", "label": "Stated a career direction that unifies the entire record", "detail": "'Mr. Larson's interests include workforce development of fields in transition, helping engineers and technicians adapt to new technologies, particularly those of the energy and power sector.'", "source": "src:ieee_cogdev", "year": 2026, "efficacy": "physiological", "agency": "personal", "kolb": "AE", "strength": 5, "prov": "verified", "layer": "public", "note": "Published in his own author biography this year. It is the only forward-looking statement in the corpus, and it retroactively makes the M.S. and the adaptive expertise work one project instead of two.", "type": "Evidence"}, {"id": "ev:bootcamp", "label": "Designed and ran a retraining bootcamp for utility workers moving into solar", "detail": "Curriculum designed, organised and hosted at LEAPS for utility workers new to solar technology, veterans, and people transitioning away from fossil fuel jobs. 'Enabling people to go back to their own communities and determine a path for energy independence.'", "source": "src:scoville", "era": "era:graduate", "year": 2019, "efficacy": "mastery", "agency": "personal", "kolb": "AE", "strength": 5, "prov": "verified", "layer": "public", "note": "Your 2026 author bio calls energy workforce development an interest. You did it in 2019. It is on no resume in this folder except as one line under a research assistantship.", "type": "Evidence"}, {"id": "ev:kenya_microgrid", "label": "Designed and installed a solar lighting system at a Kenyan community centre, and trained local staff to run it", "detail": "Two summers in Maasai Mara. Led the capstone team on a five-year development plan built around a microgrid, returned the following summer and installed the system across the facilities, with local staffers trained on operation and maintenance.", "source": "src:scoville", "era": "era:graduate", "year": 2018, "efficacy": "mastery", "agency": "collective", "kolb": "CE", "strength": 5, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:solarspell", "label": "Led ten students to build and deploy an offline solar-powered digital library across Pacific Island nations", "detail": "Designed, produced and distributed the device; travelled to Tonga and Samoa to train Peace Corps Volunteers and local teachers; led prototyping, content curation, fundraising and impact evaluation.", "source": "src:resume2024", "era": "era:undergrad", "year": 2017, "efficacy": "mastery", "agency": "collective", "kolb": "CE", "strength": 5, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:net_metering", "label": "Analysed utility rate restructuring to enable net metering on a university campus, as an elected student officer", "detail": "Vice President of Policy, Undergraduate Student Government: streamlined organisation funding, raised electrical infrastructure safety with facilities, and analysed rate restructuring to allow net metering on the Polytechnic campus.", "source": "src:resume2024", "era": "era:undergrad", "year": 2017, "efficacy": "mastery", "agency": "personal", "kolb": "AE", "strength": 4, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:eagle_project", "label": "Ran a community construction project at 17, was shut down by the municipality, re-scoped it and finished", "detail": "Built shot put and discus platforms for a school whose teams drove down the mountain to practise. Broke ground without clearing the landowners, was halted, presented to the municipality, altered the plan to meet security and maintenance concerns, and completed it.", "source": "src:eagle_essay", "era": "era:pre_college", "year": 2013, "efficacy": "mastery", "agency": "collective", "kolb": "RO", "strength": 4, "prov": "verified", "layer": "public", "note": "The earliest evidence in the graph, and the origin of a pattern that repeats for a decade: get permission from the institution, re-scope, deliver.", "type": "Evidence"}, {"id": "ev:five_first_author", "label": "First author on five publications across engineering education and energy ethics", "detail": "ASEE 2016, ASEE 2017, IEEE Transactions on Education 2020, FIE 2020, ASEE 2021, plus a sixth in publication with IEEE in 2026. First author on every one.", "source": "src:asee2021", "era": "era:research", "year": 2021, "efficacy": "mastery", "agency": "collective", "kolb": "CE", "strength": 5, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:energy_justice_pub", "label": "Published on energy justice and the ethics of emergent nuclear technology", "detail": "First author with Darshan Karwat, FIE 2020. Argued that decentralised generation requires proactive rather than reactive regulation, and that U-238 reactors offer energy density without the non-proliferation exposure of enriched fuel.", "source": "src:fie2020", "year": 2020, "efficacy": "mastery", "agency": "collective", "kolb": "AC", "strength": 4, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:unpaid_two_years", "label": "Continued the research unpaid for two years after graduating, and it produced the journal article", "detail": "Volunteer Researcher, ASU, May 2018 to May 2020, five hours a week. The IEEE Transactions on Education article came out of it.", "source": "src:resume2024", "era": "era:research", "year": 2020, "efficacy": "physiological", "agency": "personal", "kolb": "RO", "strength": 4, "prov": "verified", "layer": "public", "note": "Nobody paid you and nobody was watching. Of everything in this graph, this is the clearest signal about what you actually want to be doing.", "type": "Evidence"}, {"id": "ev:socratic_tutor", "label": "Tutored honours students Socratically for two and a half years", "detail": "Writing Tutor, Barrett Honors College, January 2016 to May 2018: 'Used the Socratic method to help students structure arguments and analyse texts.'", "source": "src:resume2024", "era": "era:undergrad", "year": 2016, "efficacy": "mastery", "agency": "personal", "kolb": "CE", "strength": 3, "prov": "verified", "layer": "public", "note": "Absent from your 2024, 2025 and 2026 resumes. It is your longest continuous teaching engagement.", "type": "Evidence"}, {"id": "ev:philosophy_corpus", "label": "Nine philosophy and ethics papers arguing one position across five years", "detail": "Plato and Boethius (2014), Marx and Nietzsche (2015), individual effect on institutions (2015), history of engineering (2016), meaning-making (2017), escaping oppression (2017), federalism and power (2018), nuclear ethics (2018), technological transitions (2019).", "source": "src:cw_institutions", "era": "era:undergrad", "year": 2017, "efficacy": "mastery", "agency": "personal", "kolb": "AC", "strength": 4, "prov": "verified", "layer": "public", "note": "Read in sequence these are not nine assignments. They are one argument about whether an individual can move an institution, worked out over five years, immediately before he spent a decade helping individuals move institutions.", "type": "Evidence"}, {"id": "ev:brece", "label": "One of ten freshman engineering students awarded the BRECE scholarship, funding two years of global engineering work", "detail": "Broadening the Reach of Engineering through Community Engagement, August 2014. Funded the Pacific Islands, Kenya and Phoenix projects.", "source": "src:resume2024", "era": "era:undergrad", "year": 2014, "efficacy": "social_persuasion", "agency": "proxy", "kolb": "CE", "strength": 4, "prov": "verified", "layer": "public", "note": "Selection evidence: someone chose you, from a field, at 18, and paid for what followed.", "type": "Evidence"}, {"id": "ev:we_the_people", "label": "Placed 14th nationally in We the People, a mock congressional testimony competition", "detail": "April 2014. Presented prepared statements and fielded questions from a panel of experts.", "source": "src:resume2024", "era": "era:pre_college", "year": 2014, "efficacy": "mastery", "agency": "collective", "kolb": "CE", "strength": 3, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:eop_paper", "label": "First-authored a study of how students recognise and use sustainability competencies", "detail": "Engineering for One Planet framework, ASEE 2021, with Karwat, Carberry and Barnard. Also facilitated workshop sessions gathering revisions to the framework itself.", "source": "src:asee2021", "year": 2021, "efficacy": "mastery", "agency": "collective", "kolb": "AC", "strength": 4, "prov": "verified", "layer": "public", "type": "Evidence"}, {"id": "ev:shuttle_analysis", "label": "Ran the techno-economic analysis for electrifying a university shuttle fleet", "detail": "Nine shuttle-charger combinations (Proterra, BYD) compared on battery capacity, range and charge rate; state-of-charge modelling across the Gold Route; payback periods computed against SRP E-32/E-36 rate plans including a $422/month demand charge. Found the campus's 1,551 kW DC solar capacity yields only 4,500 kWh/yr of excess \u2014 not enough to meet daily charging demand.", "source": "src:cw_shuttle", "era": "era:graduate", "year": 2019, "efficacy": "mastery", "agency": "collective", "kolb": "AC", "strength": 4, "prov": "verified", "layer": "public", "note": "Research Aide under PI Nathan Johnson, not lead \u2014 the honest verb is 'performed', which is what your resume already says. The finding was negative and you reported it as such.", "type": "Evidence"}, {"id": "ev:eop_survey", "label": "Designed and analysed a mixed-methods study of 117 engineering students", "detail": "Fixed-item survey of nine sustainability competencies with a full correlation matrix, plus deductive and inductive coding of 221 open-ended statements linking competencies to project-based learning. Reported a design flaw in the team's own instrument and removed affected responses.", "source": "src:asee2021", "year": 2021, "efficacy": "mastery", "agency": "collective", "kolb": "AC", "strength": 4, "prov": "verified", "layer": "public", "note": "The only quantitative study in your record. Every claim you make about being a qualitative researcher understates you by one method.", "type": "Evidence"}, {"id": "ev:coursework_to_publication", "label": "Took one argument from a class project to a fellowship application to a peer-reviewed paper", "detail": "EGR 598 final project on nuclear energy ethics (December 2018) became the Scoville Fellowship policy essay (January 2019) and then the FIE 2020 paper 'Achieving Energy Justice Through Integration of Ethics and Emergent Technology in Energy Systems' with Darshan Karwat. Same title, same thesis, three audiences.", "source": "src:cw_nuclear", "era": "era:graduate", "year": 2020, "efficacy": "mastery", "agency": "personal", "kolb": "AE", "strength": 5, "prov": "verified", "layer": "public", "note": "This is a repeatable working pattern, not a one-off: you use coursework as a first draft of publishable wor